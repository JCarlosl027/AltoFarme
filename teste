-- Espelha os requisitos mais importantes que AttackModule.Spherecast usa
-- antes de aceitar um alvo como personagem atacavel.
local function isValidNPC(model)
    if not model or not model:IsA("Model") then
        return false
    end

    if model == LocalPlayer.Character then
        return false
    end

    if model.Parent ~= Entities then
        return false
    end

    if Players:GetPlayerFromCharacter(model) then
        return false
    end

    if model:GetAttribute("PlayerCharacter") then
        return false
    end

    if model:GetAttribute("Dead") == true then
        return false
    end

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local part = getNPCPart(model)

    if not humanoid or humanoid.Health <= 0 or not part then
        return false
    end

    -- No dump, AttackModule exige Character attribute OU tag "Character".
    -- Se o seu NPC ainda nao usa isso no Studio, nao bloqueamos a selecao;
    -- apenas deixamos o status avisar para facilitar o debug.
    return true
end

local function attackModuleWillRecognize(model)
    if not model then
        return false
    end

    local okHasTag, hasTag = pcall(function()
        return model:HasTag("Character")
    end)

    return model:GetAttribute("Character") ~= nil or (okHasTag and hasTag)
end

-- ============================================================
-- Quest reader
-- ============================================================

local function readQuestTarget(force)
    if not GetData or not GetData:IsA("RemoteFunction") then
        currentQuestMob = nil
        currentQuestName = nil
        return nil
    end

    local now = os.clock()
    if not force and not forceQuestRead and now - lastQuestRead < Config.QuestRefresh then
        return currentQuestMob, currentQuestName
    end

    forceQuestRead = false
    lastQuestRead = now

    local ok, quests = pcall(function()
        return GetData:InvokeServer("Quests")
    end)

    if not ok or typeof(quests) ~= "table" then
        return currentQuestMob, currentQuestName
    end

    currentQuestMob = nil
    currentQuestName = nil
    local fallbackMob = nil
    local fallbackQuest = nil
    local preferredQuest = normalizeName(Config.PreferredQuestName or "")

    for _, quest in ipairs(quests) do
        if typeof(quest) == "table" and typeof(quest.Stages) == "table" then
            local questName = quest.Name or quest.Title or "Quest"

            for _, stage in ipairs(quest.Stages) do
                local stageIncomplete = false

                if typeof(stage) == "table" and typeof(stage.Conditions) == "table" then
                    for _, condition in ipairs(stage.Conditions) do
                        local target = condition.Target

                        if typeof(target) == "table" then
                            local amount = tonumber(target.Amount) or 0
                            local required = tonumber(target.RequiredAmount) or 1

                            if amount < required then
                                stageIncomplete = true

                                if condition.Type == "Kill" or condition.Type == "Defeat" then
                                    if preferredQuest ~= ""
                                        and string.find(normalizeName(questName), preferredQuest, 1, true)
                                    then
                                        currentQuestMob = target.Name
                                        currentQuestName = questName
                                        return currentQuestMob, currentQuestName
                                    end

                                    if not fallbackMob then
                                        fallbackMob = target.Name
                                        fallbackQuest = questName
                                    end
                                end
                            end
                        end
                    end
                end

                if stageIncomplete then
                    break
                end
            end
        end
    end

    currentQuestMob = fallbackMob
    currentQuestName = fallbackQuest
    return currentQuestMob, currentQuestName
end

-- ============================================================
-- Target selection / lifecycle
-- ============================================================

local function isTemporarilySkipped(model)
    local untilTime = failedTargets[model]
    if not untilTime then
        return false
    end

    if os.clock() >= untilTime then
        failedTargets[model] = nil
        return false
    end

    return true
end

local function skipTargetTemporarily(model)
    if model then
        failedTargets[model] = os.clock() + Config.FailedTargetCooldown
    end
end

local function hasTagSafe(model, tagName)
    local ok, result = pcall(function()
        return model:HasTag(tagName)
    end)
    return ok and result == true
end

local function isExplicitBoss(model)
    if not model then
        return false
    end

    if model:GetAttribute("Boss") == true
        or model:GetAttribute("IsBoss") == true
        or model:GetAttribute("WorldBoss") == true
        or hasTagSafe(model, "Boss")
        or hasTagSafe(model, "WorldBoss")
    then
        return true
    end

    local name = string.lower(model.Name)
    return string.find(name, "boss", 1, true) ~= nil
        or string.find(name, "world boss", 1, true) ~= nil
end

local function findBoss()
    local best = nil
    local bestScore = math.huge
    local preferredBoss = Config.BossName or ""
    local foundPreferred = false

    -- Primeiro passe: boss especifico quando configurado.
    if preferredBoss ~= "" then
        for _, model in ipairs(Entities:GetChildren()) do
            if isValidNPC(model)
                and not isTemporarilySkipped(model)
                and not isBlacklistedTarget(model)
                and isExplicitBoss(model)
                and modelMatchesText(model, preferredBoss)
            then
                local score = targetPriorityScore(model)
                if score < bestScore then
                    best = model
                    bestScore = score
                    foundPreferred = true
                end
            end
        end
        if foundPreferred or not Config.BossRotation then
            return best
        end
    end

    -- Rotacao: qualquer boss explicito disponivel.
    best = nil
    bestScore = math.huge
    for _, model in ipairs(Entities:GetChildren()) do
        if isValidNPC(model)
            and not isTemporarilySkipped(model)
            and not isBlacklistedTarget(model)
            and isExplicitBoss(model)
        then
            local score = targetPriorityScore(model)
            if score < bestScore then
                best = model
                bestScore = score
            end
        end
    end
    if best then return best end

    -- Fallback: NPC de maior MaxHealth.
    local fallback = nil
    local fallbackHP = -math.huge
    for _, model in ipairs(Entities:GetChildren()) do
        if isValidNPC(model)
            and not isTemporarilySkipped(model)
            and not isBlacklistedTarget(model)
        then
            local humanoid = model:FindFirstChildOfClass("Humanoid")
            if humanoid and humanoid.MaxHealth > fallbackHP then
                fallback = model
                fallbackHP = humanoid.MaxHealth
            end
        end
    end
    return fallback
end

local function findNearest(wanted)
    local best = nil
    local bestScore = math.huge

    for _, model in ipairs(Entities:GetChildren()) do
        if isValidNPC(model)
            and not isTemporarilySkipped(model)
            and not isBlacklistedTarget(model)
            and mobNameMatches(model, wanted)
        then
            local score = targetPriorityScore(model)
            if score < bestScore then
                best = model
                bestScore = score
            end
        end
    end

    return best
end

local function disconnectTargetConnections()
    for _, connection in ipairs(targetConnections) do
        pcall(function()
            connection:Disconnect()
        end)
    end
    table.clear(targetConnections)
end

local function getCanSwingInfo()
    local character = LocalPlayer.Character
    if not character then
        return false, "sem personagem"
    end

    local ok, allowed, blockedState = pcall(function()
        return StateService.GetPermission(character, "CanSwing")
    end)

    if not ok then
        return false, "erro StateService"
    end

    if allowed then
        return true, nil
    end

    return false, tostring(blockedState or "CanSwing=false")
end

