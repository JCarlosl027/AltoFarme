-- ============================================================
-- Main retarget loop
-- ============================================================

task.spawn(function()
    while gui.Parent do
        if not Config.Enabled then
            status.Text = "Status: parado\nInsert: mostrar/ocultar painel"
            task.wait(0.12)
            continue
        end

        local character, _, playerHumanoid = getCharacter()
        if not character then
            setM1Held(false)
            status.Text = "Aguardando personagem..."
            task.wait(0.15)
            continue
        end

        if Config.LowHealthPause and playerHumanoid and playerHumanoid.MaxHealth > 0 then
            local hpPercent = (playerHumanoid.Health / playerHumanoid.MaxHealth) * 100

            if not healthPaused and hpPercent <= Config.LowHealthPercent then
                healthPaused = true
                setM1Held(false)
            elseif healthPaused and hpPercent >= Config.ResumeHealthPercent then
                healthPaused = false
                targetLastHealthChangeAt = os.clock()
            end

            if healthPaused then
                status.Text = string.format(
                    "PAUSADO POR HP BAIXO\nHP: %.0f%% | retoma em %d%%\nAlvo mantido: %s",
                    hpPercent,
                    Config.ResumeHealthPercent,
                    currentTarget and currentTarget.Name or "--"
                )
                task.wait(0.10)
                continue
            end
        else
            healthPaused = false
        end

        local wanted = nil
        if Config.Mode == "Quest" then
            wanted = readQuestTarget(false)
        end

        if Config.Mode == "Quest" and Config.QuestChain and not wanted and not currentTarget then
            pcall(function()
                triggerQuestTalk(true)
            end)
            forceQuestRead = true
        end

        if currentTarget then
            if Config.StuckSkip
                and isValidNPC(currentTarget)
                and targetLastHealthChangeAt > 0
                and os.clock() - targetLastHealthChangeAt >= Config.StuckSeconds
            then
                if Config.StuckRecovery2 and currentRecoveryAttempt < Config.MaxRecoveryAttempts then
                    currentRecoveryAttempt += 1
                    targetLastHealthChangeAt = os.clock()
                    attackStatus = string.format(
                        "Recovery %d/%d: mudando posicao",
                        currentRecoveryAttempt,
                        Config.MaxRecoveryAttempts
                    )
                    debugLog(attackStatus)
                else
                    skipTargetTemporarily(currentTarget)
                    attackStatus = "NPC sem progresso apos recovery; pulando"
                    clearTarget()
                end
            end
        end

        if currentTarget then
            local wrongQuestTarget = Config.Mode == "Quest"
                and wanted
                and not mobNameMatches(currentTarget, wanted)

            if not isValidNPC(currentTarget) or wrongQuestTarget then
                clearTarget()
            end
        end

        if not currentTarget and os.clock() >= nextRetargetAt then
            local target
            if Config.Mode == "Boss" then
                target = findBoss()
            else
                target = findNearest(wanted)
            end

            if target then
                setTarget(target)
            end
        end

        if currentTarget and isValidNPC(currentTarget) then
            local humanoid = currentTarget:FindFirstChildOfClass("Humanoid")
            local displayName = currentTarget.Name
            if humanoid and humanoid.DisplayName ~= "" then
                displayName = humanoid.DisplayName
            end

            local hpText = "?"
            if humanoid then
                hpText = string.format("%d/%d", math.floor(humanoid.Health), math.floor(humanoid.MaxHealth))
            end

            local recognized = attackModuleWillRecognize(currentTarget)
            local recognitionText = recognized
                and "Character/tag OK"
                or "AVISO: sem atributo/tag Character"

            local distanceWarning = Config.BelowDistance > 4
                and " | longe: M1 pode ficar fora do hitbox"
                or ""

            local canSwingNow, blockedNow = getCanSwingInfo()
            local stuckLeft = ""
            if Config.StuckSkip and targetLastHealthChangeAt > 0 then
                stuckLeft = string.format(
                    " | skip %.1fs",
                    math.max(0, Config.StuckSeconds - (os.clock() - targetLastHealthChangeAt))
                )
            end

            local dps = getDamageDPS()
            local targetSwings = math.max(0, attackFireCount - targetAttackStartCount)
            local misses = math.max(0, targetSwings - targetHitCount)

            status.Text = string.format(
                [[Modo:%s | Profile:%s | Attack:%s
Alvo:%s | HP:%s | Priority:%s
DPS(%.0fs): %.1f | Dano:%.0f | Hits:%d | Miss:%d
M1:%s | %s
Ataque:%s
CanSwing:%s%s | Fires:%d
Pos:%s | Dist:%.2f | Recovery:%d/%d
%s
Quest alvo:%s]],
                tostring(Config.Mode),
                tostring(Config.FarmProfile),
                tostring(Config.AttackMode),
                tostring(displayName),
                hpText,
                tostring(Config.TargetPriority),
                Config.DamageWindow,
                dps,
                targetDamageTotal,
                targetHitCount,
                misses,
                attackHeld and "SEGURADO" or "solto",
                inputDriverName,
                attackStatus,
                canSwingNow and "SIM" or "NAO",
                (not canSwingNow and blockedNow) and (" (" .. tostring(blockedNow) .. ")") or "",
                attackFireCount,
                tostring(Config.PositionMode),
                Config.BelowDistance,
                currentRecoveryAttempt,
                Config.MaxRecoveryAttempts,
                recognitionText,
                tostring(wanted or "--")
            )
        else
            setM1Held(false)

            if Config.Mode == "Quest" then
                if wanted then
                    status.Text = string.format(
                        "Quest: %s\nProcurando: %s\nNenhum NPC correspondente vivo agora.",
                        tostring(currentQuestName or "Quest"),
                        tostring(wanted)
                    )
                else
                    status.Text = Config.QuestChain and "Quest Chain: procurando/acionando NPC de quest..." or "Nenhuma condicao Kill/Defeat ativa.\nTroque o modo ou avance a quest."
                end
            elseif Config.Mode == "Boss" then
                status.Text = "Modo Boss: procurando boss vivo.\nFiltro: " .. tostring(Config.BossName ~= "" and Config.BossName or "qualquer") .. " | Rotacao: " .. tostring(Config.BossRotation)
            else
                status.Text = "Procurando NPC vivo em workspace.Entities..."
            end
        end

        advancedInfo.Text = string.format(
            "Target: %s\nBlacklist: %s\nBoss: %s | Rotation:%s\nQuest pref: %s\nWeapon: %s\nStyle desejado: %s | atual:%s\nHitbox debug: %s | SafeRange:%.1f",
            Config.PreferredTargetName ~= "" and Config.PreferredTargetName or "--",
            Config.TargetBlacklist ~= "" and Config.TargetBlacklist or "--",
            Config.BossName ~= "" and Config.BossName or "--",
            Config.BossRotation and "ON" or "OFF",
            Config.PreferredQuestName ~= "" and Config.PreferredQuestName or "--",
            Config.PreferredWeapon ~= "" and Config.PreferredWeapon or "best",
            Config.PreferredFightingStyle ~= "" and Config.PreferredFightingStyle or "--",
            getCurrentAttackStyle(),
            Config.HitboxDebug and "ON" or "OFF",
            Config.SafeAttackRange
        )

        task.wait(0.06)
    end
end)

