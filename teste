local function triggerNearbyLoot()
    local character, root = getCharacter()
    if not character or not root then return end

    local drops = workspace:FindFirstChild("Drops")
    if drops then
        for _, obj in ipairs(drops:GetDescendants()) do
            if obj:IsA("BasePart") and obj:GetAttribute("Touch") == "Drop" then
                local dist = (obj.Position - root.Position).Magnitude
                if dist <= 120 then
                    obj:SetAttribute("Touching", true)
                end
            end
        end
    end

    -- Interacoes de chest/loot/pickup proximas. Faz a varredura pesada no maximo
    -- uma vez por segundo para nao custar FPS em mapas grandes.
    if os.clock() - lastLootPromptScan < 1 then
        return
    end
    lastLootPromptScan = os.clock()

    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local parentPart = obj.Parent and (obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart", true))
            if parentPart then
                local d = (parentPart.Position - root.Position).Magnitude
                if d <= Config.AutoLootPromptRange then
                    local label = string.lower((obj.ActionText or "") .. " " .. (obj.ObjectText or "") .. " " .. obj.Name)
                    if string.find(label, "loot", 1, true)
                        or string.find(label, "chest", 1, true)
                        or string.find(label, "pickup", 1, true)
                        or string.find(label, "collect", 1, true)
                    then
                        pcall(function()
                            obj:InputHoldBegin()
                            task.delay(math.max(obj.HoldDuration, 0.05), function()
                                if obj and obj.Parent then obj:InputHoldEnd() end
                            end)
                        end)
                    end
                end
            end
        end
    end
end

