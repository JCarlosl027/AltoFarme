local function getAnyBasePart(instance)
    if not instance then return nil end
    if instance:IsA("BasePart") then return instance end
    if instance:IsA("Model") and instance.PrimaryPart then return instance.PrimaryPart end
    return instance:FindFirstChildWhichIsA("BasePart", true)
end

local function getItemNameFromInventoryEntry(key, entry)
    if typeof(entry) == "table" and typeof(entry.Name) == "string" then
        return entry.Name
    end
    return key
end

local function bestInventoryIdByType(wantedType)
    local inventory = ClientCache.Data and ClientCache.Data.Inventory
    if typeof(inventory) ~= "table" then
        return nil, nil
    end

    local bestId, bestName, bestScore = nil, nil, -math.huge

    for key, entry in pairs(inventory) do
        local itemName = getItemNameFromInventoryEntry(key, entry)
        local info = ItemInfo.Get(itemName)

        if info and info.Type == wantedType then
            local score = tonumber(info.Price) or 0
            if wantedType == "Weapon" and Config.PreferredWeapon ~= "" then
                if containsNormalized(itemName, Config.PreferredWeapon) then
                    score += 1000000
                else
                    score -= 100000
                end
            end
            if wantedType == "Pickaxe" and typeof(info.MiningStats) == "table" then
                score = (tonumber(info.MiningStats.Damage) or 0) * 100
                    + (tonumber(info.MiningStats.Control) or 0) * 3
                    + (tonumber(info.MiningStats.Luck) or 0)
            end

            local candidateId = key
            if info.Upgradable and typeof(entry) == "table" and typeof(entry.Copies) == "table" then
                for copyId in pairs(entry.Copies) do
                    candidateId = copyId
                    break
                end
            end

            if score > bestScore then
                bestScore = score
                bestId = candidateId
                bestName = itemName
            end
        end
    end

    return bestId, bestName
end

local function heldType()
    local heldId, heldModel = HeldClient.GetHeld()
    if not heldModel then
        return heldId, nil, nil
    end

    local itemName = heldModel:GetAttribute("ItemName") or heldModel.Name
    local info = ItemInfo.Get(itemName)
    return heldId, heldModel, info and info.Type or nil
end

local function ensureHeldType(wantedType)
    local heldId, heldModel, currentType = heldType()
    if currentType == wantedType and heldModel then
        return heldModel, true
    end

    local itemId, itemName = bestInventoryIdByType(wantedType)
    if not itemId then
        utilityStatus = "sem item do tipo " .. tostring(wantedType)
        return nil, false
    end

    if heldId ~= itemId then
        HeldClient.RequestEquip(itemId)
        utilityStatus = "equipando " .. tostring(itemName)
    end

    return nil, false
end

local function isOreAlive(ore)
    if not ore or not ore:IsDescendantOf(workspace) then return false end
    if ore:GetAttribute("Mined") == true then return false end
    local part = getAnyBasePart(ore)
    return part ~= nil
end

local function oreName(ore)
    if not ore then return "--" end
    return tostring(ore:GetAttribute("Ore") or (getAnyBasePart(ore) and getAnyBasePart(ore):GetAttribute("Ore")) or ore.Name)
end

local function findNearestOre()
    local _, root = getCharacter()
    if not root then return nil end

    local best, bestDist = nil, math.huge
    for _, ore in ipairs(CollectionService:GetTagged("Ore")) do
        if isOreAlive(ore) then
            local part = getAnyBasePart(ore)
            local dist = (root.Position - part.Position).Magnitude
            if dist <= Config.AutoMineSearchRange and dist < bestDist then
                best, bestDist = ore, dist
            end
        end
    end
    return best, bestDist
end

local function groundYForPosition(position, character, ignoredObject)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local filter = { character }
    if ignoredObject then table.insert(filter, ignoredObject) end
    params.FilterDescendantsInstances = filter

    local origin = Vector3.new(position.X, position.Y + 45, position.Z)
    local result = workspace:Raycast(origin, Vector3.new(0, -140, 0), params)
    return result and result.Position.Y or nil
end

local function rootYFromGround(groundY, humanoid, root)
    if not groundY then
        return root.Position.Y
    end
    return groundY + humanoid.HipHeight + root.Size.Y / 2
end

local function approachAxis(current, target, maxStep)
    local delta = target - current
    if math.abs(delta) <= maxStep then
        return target
    end
    return current + math.sign(delta) * maxStep
end

local function getStableMineY(ore, desiredXZ, character, humanoid, root)
    if mineYLockTarget ~= ore or mineYLock == nil then
        local part = getAnyBasePart(ore)
        local groundY = groundYForPosition(desiredXZ, character, ore)

        local candidate
        if groundY then
            candidate = rootYFromGround(groundY, humanoid, root)
        elseif part then
            -- Fallback quando nao existe chao raycastavel no X/Z escolhido.
            -- Usa a base do proprio minerio em vez de herdar o Y anterior.
            local bottomY = part.Position.Y - part.Size.Y / 2
            candidate = bottomY + humanoid.HipHeight + root.Size.Y / 2
        else
            candidate = desiredXZ.Y
        end

        mineYLockTarget = ore
        mineYLock = candidate
        debugLog(string.format(
            "Mine layer => Y %.2f | delta %.1f",
            mineYLock,
            mineYLock - root.Position.Y
        ))
    end
    return mineYLock
end

local function getStableChestY(prompt, desiredXZ, character, humanoid, root, interactable)
    if chestYLockTarget ~= prompt or chestYLock == nil then
        local part = getAnyBasePart(interactable)
        local groundY = groundYForPosition(desiredXZ, character, interactable)

        local candidate
        if groundY then
            candidate = rootYFromGround(groundY, humanoid, root)
        elseif part then
            local bottomY = part.Position.Y - part.Size.Y / 2
            candidate = bottomY + humanoid.HipHeight + root.Size.Y / 2
        else
            candidate = desiredXZ.Y
        end

        chestYLockTarget = prompt
        chestYLock = candidate
        debugLog(string.format(
            "Chest layer => Y %.2f | delta %.1f",
            chestYLock,
            chestYLock - root.Position.Y
        ))
    end
    return chestYLock
end

local function moveTowardOre(ore, dt)
    local character, root, humanoid = getCharacter()
    local part = getAnyBasePart(ore)
    if not character or not root or not humanoid or not part then
        return false, math.huge
    end

    humanoid.AutoRotate = false

    local poseCount = math.max(1, Config.MinePoseCount)
    local angle = math.rad((minePoseIndex % poseCount) * (360 / poseCount))
    local offset = Vector3.new(math.cos(angle), 0, math.sin(angle)) * Config.AutoMineDistance
    local desiredXZ = part.Position + offset

    -- Calcula o Y UMA VEZ para este ore e mantem essa altura.
    local lockedY = getStableMineY(ore, desiredXZ, character, humanoid, root)

    local horizontalDelta = Vector3.new(
        desiredXZ.X - root.Position.X,
        0,
        desiredXZ.Z - root.Position.Z
    )
    local horizontalDistance = horizontalDelta.Magnitude
    local horizontalStep = math.min(
        horizontalDistance,
        Config.AutoMineMoveSpeed * math.max(dt, 1/120)
    )

    local newX, newZ = root.Position.X, root.Position.Z
    if horizontalDistance > 0.001 then
        local h = horizontalDelta.Unit * horizontalStep
        newX += h.X
        newZ += h.Z
    else
        newX = desiredXZ.X
        newZ = desiredXZ.Z
    end

    -- Movimento vertical separado e limitado. Nao segue o raycast a cada frame.
    local maxYStep = Config.AutoMineVerticalSpeed * math.max(dt, 1/120)
    local newY = approachAxis(root.Position.Y, lockedY, maxYStep)
    local newPos = Vector3.new(newX, newY, newZ)

    local flatLook = Vector3.new(part.Position.X, newY, part.Position.Z)
    if (flatLook - newPos).Magnitude < 0.01 then
        flatLook = newPos + Vector3.new(0, 0, -1)
    end

    root.CFrame = CFrame.lookAt(newPos, flatLook, Vector3.yAxis)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local verticalReady = math.abs(newY - lockedY) <= 0.35
    local horizontalReady = horizontalDistance <= 0.65
    local actualDistance = (part.Position - newPos).Magnitude

    if horizontalReady and verticalReady then
        -- Mantem exatamente a posicao de mineracao ao chegar. Isso impede
        -- pequenos deltas fisicos de tirar o PickaxeTip de range.
        local finalPos = Vector3.new(desiredXZ.X, lockedY, desiredXZ.Z)
        local finalLook = Vector3.new(part.Position.X, lockedY, part.Position.Z)
        if (finalLook - finalPos).Magnitude < 0.01 then
            finalLook = finalPos + Vector3.new(0, 0, -1)
        end
        root.CFrame = CFrame.lookAt(finalPos, finalLook, Vector3.yAxis)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
    end

    return horizontalReady and verticalReady, actualDistance
end

local function activatePickaxeOnce()
    local heldModel, ready = ensureHeldType("Pickaxe")
    if not ready or not heldModel then return false end

    local now = os.clock()
    if now - lastMineActivate < Config.AutoMineActivateInterval then return false end

    lastMineActivate = now
    minePoseAttempts += 1

    local ok, err = pcall(function()
        ToolFunctions.Run(heldModel, "Activated")
    end)

    if ok then
        utilityStatus = string.format("pickaxe swing | pose %d/%d", minePoseIndex + 1, Config.MinePoseCount)
        debugLog(utilityStatus)
        if minePoseAttempts >= Config.MinePoseRetries then
            minePoseAttempts = 0
            minePoseIndex = (minePoseIndex + 1) % math.max(1, Config.MinePoseCount)

            -- Cada nova pose recebe sua propria leitura de chao. Nao herda uma
            -- leitura ruim feita do outro lado do minerio.
            mineYLockTarget = nil
            mineYLock = nil
        end
    else
        utilityStatus = "erro pickaxe: " .. tostring(err)
        debugLog(utilityStatus)
    end

    return ok
end

