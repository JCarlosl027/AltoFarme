-- ============================================================
-- Character helpers
-- ============================================================

local function getCharacter()
    local character = LocalPlayer.Character
    if not character then
        return nil
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    local root = character:FindFirstChild("HumanoidRootPart") or character.PrimaryPart

    if not humanoid or not root or humanoid.Health <= 0 then
        return nil
    end

    return character, root, humanoid
end

local function getNPCPart(model)
    if not model then
        return nil
    end

    return model.PrimaryPart
        or model:FindFirstChild("HumanoidRootPart")
        or model:FindFirstChild("UpperTorso")
        or model:FindFirstChild("Torso")
        or model:FindFirstChild("Head")
end

local function getLookPart(model)
    if not model then
        return nil
    end

    return model:FindFirstChild("Head") or getNPCPart(model)
end

local function normalizeName(value)
    if typeof(value) ~= "string" then
        return ""
    end

    local s = string.lower(value)
    s = string.gsub(s, '^"', "")
    s = string.gsub(s, '"$', "")
    s = string.gsub(s, "%s+%[%d+%]$", "")
    s = string.gsub(s, "%s+%(%d+%)$", "")
    s = string.gsub(s, "%s+%d+$", "")
    s = string.gsub(s, "^%s+", "")
    s = string.gsub(s, "%s+$", "")
    return s
end

local function mobNameMatches(model, wanted)
    if not wanted then
        return true
    end

    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    local wantedNormalized = normalizeName(wanted)

    local candidates = {
        model and model:GetAttribute("NPCName"),
        model and model:GetAttribute("MobName"),
        model and model:GetAttribute("DisplayName"),
        humanoid and humanoid.DisplayName,
        model and model.Name,
    }

    for _, candidate in ipairs(candidates) do
        if normalizeName(candidate) == wantedNormalized then
            return true
        end
    end

    return false
end

local function containsNormalized(haystack, needle)
    needle = normalizeName(needle)
    if needle == "" then return true end
    haystack = normalizeName(haystack)
    return string.find(haystack, needle, 1, true) ~= nil
end

local function modelMatchesText(model, textValue)
    if not model then return false end
    textValue = normalizeName(textValue)
    if textValue == "" then return true end
    local humanoid = model:FindFirstChildOfClass("Humanoid")
    local values = {
        model.Name,
        model:GetAttribute("NPCName"),
        model:GetAttribute("MobName"),
        model:GetAttribute("DisplayName"),
        humanoid and humanoid.DisplayName,
    }
    for _, value in ipairs(values) do
        if containsNormalized(value, textValue) then
            return true
        end
    end
    return false
end

local function isBlacklistedTarget(model)
    local raw = Config.TargetBlacklist or ""
    if raw == "" then return false end
    for token in string.gmatch(raw, "[^,;]+") do
        token = string.gsub(token, "^%s+", "")
        token = string.gsub(token, "%s+$", "")
        if token ~= "" and modelMatchesText(model, token) then
            return true
        end
    end
    return false
end

local function getTargetDistance(model)
    local _, root = getCharacter()
    local part = getNPCPart(model)
    if not root or not part then return math.huge end
    return (root.Position - part.Position).Magnitude
end

local function targetPriorityScore(model)
    local humanoid = model and model:FindFirstChildOfClass("Humanoid")
    local distance = getTargetDistance(model)
    if not humanoid then return math.huge end

    local preferred = Config.PreferredTargetName or ""
    local preferredBonus = 0
    if preferred ~= "" and modelMatchesText(model, preferred) then
        preferredBonus = -1000000
    end

    if Config.TargetPriority == "LowHP" then
        return preferredBonus + humanoid.Health + distance * 0.01
    elseif Config.TargetPriority == "HighHP" then
        return preferredBonus - humanoid.Health + distance * 0.01
    elseif Config.TargetPriority == "Name" then
        return preferredBonus + distance
    end

    return preferredBonus + distance
end

local function getDamageDPS()
    local now = os.clock()
    local window = math.max(1, Config.DamageWindow or 5)
    local total = 0
    local kept = {}
    for _, event in ipairs(damageEvents) do
        if now - event.t <= window then
            total += event.damage
            table.insert(kept, event)
        end
    end
    damageEvents = kept
    return total / window
end

