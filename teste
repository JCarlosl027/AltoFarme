local CHEST_PROMPT_NAMES = {
    ["Chest"] = true,
    ["Fruit Chest"] = true,
    ["World Boss Chest"] = true,
    ["Afuaru's Chest"] = true,
}

local function getPromptInteractable(prompt)
    local ok, result = pcall(function()
        return PromptInfoUtilities.GetInteractablePart(prompt)
    end)
    if ok and result then return result end
    return prompt and prompt.Parent or nil
end

local function isChestPrompt(prompt)
    if not prompt or not prompt:IsA("ProximityPrompt") or not prompt.Enabled then return false end
    if CHEST_PROMPT_NAMES[prompt.Name] then return true end
    local label = string.lower((prompt.Name or "") .. " " .. (prompt.ActionText or "") .. " " .. (prompt.ObjectText or ""))
    return string.find(label, "chest", 1, true) ~= nil
end

local function chestAvailable(prompt)
    if not isChestPrompt(prompt) or not prompt:IsDescendantOf(workspace) then return false end
    if completedChests[prompt] then return false end

    local object = getPromptInteractable(prompt)
    if not object then return false end
    if object:GetAttribute("Opened") then return false end
    if object:GetAttribute("Opening") then return false end
    return getAnyBasePart(object) ~= nil
end

local function findNearestChest()
    local _, root = getCharacter()
    if not root then return nil, math.huge end

    local best, bestDist = nil, math.huge
    for _, obj in ipairs(workspace:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and chestAvailable(obj) then
            local interactable = getPromptInteractable(obj)
            local part = getAnyBasePart(interactable)
            if part then
                local d = (root.Position - part.Position).Magnitude
                if d <= Config.AutoChestSearchRange and d < bestDist then
                    best, bestDist = obj, d
                end
            end
        end
    end
    return best, bestDist
end

local function moveTowardChest(prompt, dt)
    local character, root, humanoid = getCharacter()
    local interactable = getPromptInteractable(prompt)
    local part = getAnyBasePart(interactable)
    if not character or not root or not humanoid or not part then
        return false, math.huge
    end

    humanoid.AutoRotate = false

    local toChest = part.Position - root.Position
    local horizontal = Vector3.new(toChest.X, 0, toChest.Z)
    local dir = horizontal.Magnitude > 0.05 and horizontal.Unit or -part.CFrame.LookVector

    -- Nunca para fora do alcance do prompt.
    -- Ex.: MaxActivationDistance=5 -> tenta ficar ~2.75 studs do chest.
    local promptRange = tonumber(prompt.MaxActivationDistance) or 8
    local safeStandDistance = math.min(
        Config.AutoChestInteractDistance,
        math.max(1.25, promptRange * 0.55)
    )

    local desiredXZ = part.Position - dir * safeStandDistance

    -- Calcula o Y apenas quando escolhe este chest.
    local lockedY = getStableChestY(
        prompt,
        desiredXZ,
        character,
        humanoid,
        root,
        interactable
    )

    local horizontalDelta = Vector3.new(
        desiredXZ.X - root.Position.X,
        0,
        desiredXZ.Z - root.Position.Z
    )
    local horizontalDistance = horizontalDelta.Magnitude
    local horizontalStep = math.min(
        horizontalDistance,
        Config.AutoChestMoveSpeed * math.max(dt, 1/120)
    )

    local newX, newZ = root.Position.X, root.Position.Z
    if horizontalDistance > 0.001 then
        local h = horizontalDelta.Unit * horizontalStep
        newX += h.X
        newZ += h.Z
    else
        newX = desiredXZ.X
        newZ = desiredXZ.Z
    end

    local maxYStep = Config.AutoChestVerticalSpeed * math.max(dt, 1/120)
    local newY = approachAxis(root.Position.Y, lockedY, maxYStep)
    local newPos = Vector3.new(newX, newY, newZ)

    local lookAt = Vector3.new(part.Position.X, newY, part.Position.Z)
    if (lookAt - newPos).Magnitude < 0.01 then
        lookAt = newPos + Vector3.new(0, 0, -1)
    end

    root.CFrame = CFrame.lookAt(newPos, lookAt, Vector3.yAxis)
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero

    local actualDistance = (part.Position - newPos).Magnitude
    local activationDistance = math.max(1.25, promptRange - 0.6)

    local verticalReady = math.abs(newY - lockedY) <= 0.35
    local horizontalReady = horizontalDistance <= 0.65

    if horizontalReady and verticalReady then
        local finalPos = Vector3.new(desiredXZ.X, lockedY, desiredXZ.Z)
        local finalLook = Vector3.new(part.Position.X, lockedY, part.Position.Z)
        if (finalLook - finalPos).Magnitude < 0.01 then
            finalLook = finalPos + Vector3.new(0, 0, -1)
        end
        root.CFrame = CFrame.lookAt(finalPos, finalLook, Vector3.yAxis)
        root.AssemblyLinearVelocity = Vector3.zero
        root.AssemblyAngularVelocity = Vector3.zero
        actualDistance = (part.Position - finalPos).Magnitude
    end

    return horizontalReady and verticalReady and actualDistance <= activationDistance, actualDistance
end

