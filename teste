        return
    end

    local current = getCurrentAttackStyle()
    if current ~= style then
        pcall(function()
            AttackStyles.SetUnarmedAttackStyle(character, style)
        end)
        utilityStatus = "style Client => " .. tostring(style)
    end
end

local function getEquippedSkills()
    local result = {}
    local skills = ClientCache.Data and ClientCache.Data.Skills
    if typeof(skills) ~= "table" then return result end

    for skillName, data in pairs(skills) do
        if typeof(data) == "table" and data.Equipped then
            local info = SkillInformation.GetSkillInfo(skillName)
            if info then table.insert(result, skillName) end
        end
    end
    table.sort(result)
    return result
end

local skillCursor = 0
local function fireOneAutoSkill()
    if not Config.AutoSkills or not Config.Enabled or Config.AutoMine then return end
    if not currentTarget or not isValidNPC(currentTarget) then return end
    if not InputRemote or not InputRemote:IsA("RemoteEvent") then return end

    local now = os.clock()
    if now - lastAutoSkill < Config.AutoSkillInterval then return end
    lastAutoSkill = now

    local skills = getEquippedSkills()
    if #skills == 0 then
        utilityStatus = "Auto Skills: nenhum skill equipado"
        return
    end

    skillCursor = skillCursor % #skills + 1
    local skillName = skills[skillCursor]
    local character = LocalPlayer.Character
    local targetPart = getNPCPart(currentTarget)
    if not character or not targetPart then return end

    local common = {
        Input = skillName,
        ID = skillName,
        Character = character,
        ExtraInfo = { Targets = { currentTarget } },
        Targets = { currentTarget },
        Mouse = CFrame.new(targetPart.Position),
        CFrame = character:GetPivot(),
    }

    local press = table.clone(common)
    press.State = true
    InputRemote:FireServer(press)

    task.delay(0.08, function()
        if not InputRemote or not InputRemote.Parent or not character.Parent then return end
        local release = table.clone(common)
        release.State = false
        release.HeldDuration = 0.08
        InputRemote:FireServer(release)
    end)

    utilityStatus = "skill: " .. skillName
end

local function nearestDialoguePrompt()
    local _, root = getCharacter()
    if not root then return nil end

    local important = workspace:FindFirstChild("AA IMPORTANT")
    local dialogueRoot = important and important:FindFirstChild("DialogueNPCs", true)
    local searchRoot = dialogueRoot or workspace

    local best, bestDist = nil, Config.AutoQuestTalkRange
    for _, obj in ipairs(searchRoot:GetDescendants()) do
        if obj:IsA("ProximityPrompt") and obj.Enabled then
            local part = obj.Parent and (obj.Parent:IsA("BasePart") and obj.Parent or obj.Parent:FindFirstChildWhichIsA("BasePart", true))
            if part then
                local d = (part.Position - root.Position).Magnitude
                local label = string.lower((obj.ActionText or "") .. " " .. (obj.ObjectText or "") .. " " .. obj.Name)
                local looksLikeTalk = string.find(label, "talk", 1, true)
                    or string.find(label, "speak", 1, true)
                    or string.find(label, "quest", 1, true)
                    or dialogueRoot ~= nil
                if looksLikeTalk and d < bestDist then
                    best, bestDist = obj, d
                end
            end
        end
    end
    return best
end

local function triggerQuestTalk(force)
    if not force and not Config.AutoQuestTalk then return end
    if os.clock() - lastQuestTalk < 1.2 then return end
    lastQuestTalk = os.clock()

    local prompt = nearestDialoguePrompt()
    if not prompt then return end

    local ok, driver = studioFirePrompt(prompt)
    utilityStatus = "quest talk: "
        .. tostring(prompt.ObjectText ~= "" and prompt.ObjectText or prompt.Name)
        .. " | " .. tostring(ok and driver or "falhou")
end

