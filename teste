local function clearHitboxDebug()
    if hitboxDebugPart then
        pcall(function() hitboxDebugPart:Destroy() end)
        hitboxDebugPart = nil
    end
    if hitboxTargetHighlight then
        pcall(function() hitboxTargetHighlight:Destroy() end)
        hitboxTargetHighlight = nil
    end
end

local function refreshHitboxDebug()
    if not Config.HitboxDebug or not Config.Enabled then
        clearHitboxDebug()
        return
    end

    local character, root = getCharacter()
    if not character or not root then
        clearHitboxDebug()
        return
    end

    if not hitboxDebugPart then
        local part = Instance.new("Part")
        part.Name = "D2AttackRangeDebug"
        part.Shape = Enum.PartType.Ball
        part.Anchored = true
        part.CanCollide = false
        part.CanTouch = false
        part.CanQuery = false
        part.Material = Enum.Material.ForceField
        part.Transparency = 0.72
        part.Parent = workspace
        hitboxDebugPart = part
    end

    local range = math.max(1, Config.HitboxDebugRange)
    hitboxDebugPart.Size = Vector3.new(range * 2, range * 2, range * 2)
    hitboxDebugPart.CFrame = root.CFrame + root.CFrame.LookVector * (range * 0.35)

    if currentTarget and isValidNPC(currentTarget) then
        if not hitboxTargetHighlight or hitboxTargetHighlight.Adornee ~= currentTarget then
            if hitboxTargetHighlight then
                hitboxTargetHighlight:Destroy()
            end
            local h = Instance.new("Highlight")
            h.Name = "D2TargetDebug"
            h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
            h.FillTransparency = 0.82
            h.OutlineTransparency = 0.05
            h.Adornee = currentTarget
            h.Parent = currentTarget
            hitboxTargetHighlight = h
        end
    elseif hitboxTargetHighlight then
        hitboxTargetHighlight:Destroy()
        hitboxTargetHighlight = nil
    end
end

