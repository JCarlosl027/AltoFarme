local function autoApplyFightingStyle()
    if not Config.AutoFightingStyle or not Config.Enabled then return end
    local character = LocalPlayer.Character
    if not character then return end

    local requested = Config.PreferredFightingStyle or ""
    if requested == "" then return end

    local style = nil
    if AttackStyles.cache then
        for styleName in pairs(AttackStyles.cache) do
            if normalizeName(styleName) == normalizeName(requested) then
                style = styleName
                break
            end
        end
    end

    if not style then
