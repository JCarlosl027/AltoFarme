    end

    return true
end

-- ============================================================
-- SISTEMA DE COMBATE CLIENT (AttackModule.Swing)
-- ============================================================
local function getAttackInterval()
    if Config.AttackMode == "Fast" then
        return 0.02
    elseif Config.AttackMode == "Safe" then
        return 0.08
    elseif Config.AttackMode == "Combo" then
        return 0.04
    end
    return Config.AttackPollInterval
end

local function processAttack()
    if not attackHeld then
        return
    end

    local now = os.clock()
    if now - lastAttackAttempt < getAttackInterval() then
        return
    end
    lastAttackAttempt = now

    local character, root = getCharacter()
    if not character or not root then
        attackStatus = "sem personagem"
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not humanoid or humanoid.Health <= 0 then
        attackStatus = "personagem morto"
        return
    end

    if Config.AttackMode == "Safe" and currentTarget then
        local distance = getTargetDistance(currentTarget)
        if distance > Config.SafeAttackRange then
            attackStatus = string.format("Safe: fora do range %.1f", distance)
            return
        end
        if not attackModuleWillRecognize(currentTarget) then
            attackStatus = "Safe: alvo sem Character/tag"
            return
        end
    end

    local canSwing, blockedState = getCanSwingInfo()
    if not canSwing then
        lastBlockedState = blockedState
        attackStatus = "bloqueado: " .. tostring(blockedState)
        return
    end
    lastBlockedState = nil

    if not AttackModule or typeof(AttackModule.Swing) ~= "function" then
        attackStatus = "AttackModule.Swing indisponivel"
        return
    end

    local comboText = ""
    if Config.AttackMode == "Combo"
        and typeof(AttackModule.GetCombo) == "function"
        and typeof(AttackModule.GetMaxCombo) == "function"
    then
        local okCombo, combo, maxCombo = pcall(function()
            return AttackModule.GetCombo(character), AttackModule.GetMaxCombo(character)
        end)
        if okCombo then
            comboText = string.format(" C%d/%d", tonumber(combo) or 0, tonumber(maxCombo) or 0)
        end
    end

    local ok, err = pcall(function()
        AttackModule.Swing(character, nil, nil)
    end)

    if not ok then
        attackStatus = "erro Swing: " .. tostring(err)
        return
    end

    lastAttackFire = now
    attackFireCount += 1
    attackStatus = "Swing OK [" .. tostring(Config.AttackMode) .. "]" .. comboText
    pendingSwingCheckAt = now + 0.05
    pendingSwingCharacter = character
end

local function clearTarget()
    setM1Held(false)
    disconnectTargetConnections()
    currentTarget = nil
    targetLastHealth = nil
    targetLastHealthChangeAt = 0
    currentRecoveryAttempt = 0
    nextRetargetAt = os.clock() + Config.RetargetDelay
    forceQuestRead = true
end

local function setTarget(model)
    if currentTarget == model then
        return
    end

    clearTarget()

    if not isValidNPC(model) then
        return
    end

    currentTarget = model
    currentRecoveryAttempt = 0
    targetDamageTotal = 0
    targetHitCount = 0
    targetAttackStartCount = attackFireCount
    damageEvents = {}
    lastTargetDamage = 0

    local humanoid = model:FindFirstChildOfClass("Humanoid")
    targetLastHealth = humanoid and humanoid.Health or nil
    targetLastHealthChangeAt = os.clock()

    if humanoid then
        table.insert(targetConnections, humanoid.Died:Connect(function()
            if currentTarget == model then
                clearTarget()
            end
        end))

        table.insert(targetConnections, humanoid.HealthChanged:Connect(function(health)
            if currentTarget ~= model then
                return
            end

            local previous = targetLastHealth
            if previous and health < previous then
                local damage = previous - health
                targetDamageTotal += damage
                targetHitCount += 1
                lastTargetDamage = damage
                table.insert(damageEvents, {
                    t = os.clock(),
                    damage = damage,
                })
            end

            if previous == nil or math.abs(health - previous) > 0.01 then
                targetLastHealth = health
                targetLastHealthChangeAt = os.clock()
            end

            if health <= 0 then
                clearTarget()
            end
        end))
    end

    table.insert(targetConnections, model.AncestryChanged:Connect(function()
        if currentTarget == model and model.Parent ~= Entities then
            clearTarget()
        end
    end))

    pcall(function()
        table.insert(targetConnections, model:GetAttributeChangedSignal("Dead"):Connect(function()
            if currentTarget == model and model:GetAttribute("Dead") == true then
                clearTarget()
            end
        end))
    end)
end

-- ============================================================
-- Smart Positioning v10
-- ============================================================

local function buildUpwardLookCFrame(position, lookPosition, targetRoot)
    local direction = lookPosition - position
    if direction.Magnitude < 0.001 then
        return CFrame.new(position)
    end

    direction = direction.Unit

    -- CFrame.lookAt(at, target, Vector3.yAxis) e degenerado quando direction
    -- fica vertical. Escolhemos um up vector perpendicular ao olhar.
    local up = Vector3.zAxis

    if targetRoot then
        local candidate = targetRoot.CFrame.RightVector
        if math.abs(direction:Dot(candidate)) < 0.95 then
            up = candidate
        end
    end

    if math.abs(direction:Dot(up)) > 0.95 then
        up = Vector3.xAxis
    end

    return CFrame.lookAt(position, lookPosition, up)
end

local function pinBelowTarget(model)
    local _, root, humanoid = getCharacter()
    local targetRoot = getNPCPart(model)
    local lookPart = getLookPart(model)

    if not root or not humanoid or not targetRoot or not lookPart then
        return false
    end

    if savedAutoRotate == nil then
        savedAutoRotate = humanoid.AutoRotate
    end
    humanoid.AutoRotate = false

    local flatForward = Vector3.new(
        targetRoot.CFrame.LookVector.X,
        0,
        targetRoot.CFrame.LookVector.Z
    )
    if flatForward.Magnitude < 0.05 then
        flatForward = Vector3.new(0, 0, -1)
    else
        flatForward = flatForward.Unit
    end

    local targetPosition = targetRoot.Position
    local distance = math.max(1, Config.BelowDistance)
    local mode = Config.SmartPositioning and Config.PositionMode or "Below"
    local farmPosition

    if mode == "Behind" then
        farmPosition = targetPosition - flatForward * distance + Vector3.new(0, 0.4, 0)
    elseif mode == "Above" then
        farmPosition = targetPosition + Vector3.new(0, distance, 0) - flatForward * Config.BackOffset
    elseif mode == "Orbit" then
        local angle = os.clock() * Config.OrbitSpeed
        local radius = math.max(2, distance)
        farmPosition = targetPosition + Vector3.new(
            math.cos(angle) * radius,
            0.4,
            math.sin(angle) * radius
        )
    else
        farmPosition = targetPosition
            - Vector3.new(0, distance, 0)
            - flatForward * Config.BackOffset
    end

    -- Stuck Recovery 2.0 muda a geometria sem abandonar o alvo imediatamente.
    if currentRecoveryAttempt > 0 then
        local recoveryAngle = currentRecoveryAttempt * (math.pi * 0.5)
        local step = Config.RecoveryStep * currentRecoveryAttempt
        farmPosition += Vector3.new(
            math.cos(recoveryAngle) * step,
            ((currentRecoveryAttempt % 2 == 0) and 0.6 or -0.6) * Config.RecoveryStep,
            math.sin(recoveryAngle) * step
        )
    end

    local lookPosition = lookPart.Position + Vector3.new(0, 0.15, 0)
    local desiredCFrame = buildUpwardLookCFrame(farmPosition, lookPosition, targetRoot)

    root.CFrame = desiredCFrame
    root.AssemblyLinearVelocity = Vector3.zero
    root.AssemblyAngularVelocity = Vector3.zero
    return true
end

